---
import Base from "../layouts/Base.astro";
import { getDB, all } from "@lib/db";
import { CATEGORIES, CATEGORY_LABEL, fmtDate } from "@lib/catalog";

const db = getDB(Astro.locals);
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim();
const category = (params.get("category") ?? "").trim();
const collection = (params.get("collection") ?? "").trim();
const video = params.get("video") === "1";
const sort = params.get("sort") === "old" ? "old" : "";

// Pills used to link to "/?category=x", which silently dropped every other
// filter. With a third row that gets confusing fast, so each pill now keeps the
// filters it isn't itself changing.
const linkTo = (over: { category?: string; collection?: string; video?: boolean; sort?: string }) => {
  const next = new URLSearchParams();
  const cat = over.category ?? category;
  const col = over.collection ?? collection;
  const vid = over.video ?? video;
  const srt = over.sort ?? sort;
  if (cat) next.set("category", cat);
  if (col) next.set("collection", col);
  if (vid) next.set("video", "1");
  if (srt) next.set("sort", srt);
  if (q) next.set("q", q);
  const s = next.toString();
  return s ? `/?${s}` : "/";
};

const ftsQuery = q
  ? q.split(/\s+/).map((t) => t.replace(/[^\p{L}\p{N}]/gu, "")).filter(Boolean).map((t) => `${t}*`).join(" ")
  : "";

const where: string[] = ["i.published = 1"];
const args: unknown[] = [];
const joins: string[] = [];
if (ftsQuery) { joins.push("JOIN item_fts ON item_fts.item_id = i.id"); where.push("item_fts MATCH ?"); args.push(ftsQuery); }
if (category) { where.push("i.category = ?"); args.push(category); }
if (collection) { where.push("co.slug = ?"); args.push(collection); }
if (video) { where.push("i.video_url IS NOT NULL"); }

// On a text search, return a highlighted excerpt (FTS5 snippet) and order by
// relevance; otherwise newest first. @@H@@/@@/H@@ are placeholder markers we turn
// into <mark> only after HTML-escaping the text (below), so transcript text can
// never inject markup.
const snipExpr = ftsQuery ? "snippet(item_fts, -1, '@@H@@', '@@/H@@', '…', 12)" : "NULL";
// Undated items sort LAST either way. SQLite puts NULLs first on ASC, which
// otherwise opened "oldest first" with a run of blank dates.
const dateOrder = sort === "old"
  ? "(i.recorded_on IS NULL), i.recorded_on ASC, i.id ASC"
  : "(i.recorded_on IS NULL), i.recorded_on DESC, i.id DESC";
const orderBy = (ftsQuery && !sort) ? "bm25(item_fts)" : dateOrder;

const items = await all<{
  id: number; slug: string; title: string; category: string; recorded_on: string;
  passage_ref: string; series_part: string; speaker_name: string; speaker_slug: string; collection_title: string;
  has_transcript: number; has_video: number; has_files: number; snip: string | null;
}>(
  db,
  `SELECT i.id, i.slug, i.title, i.category, i.recorded_on, i.passage_ref, i.series_part,
          sp.name AS speaker_name, sp.slug AS speaker_slug, co.title AS collection_title,
          (SELECT COUNT(*) FROM item_transcripts t WHERE t.item_id = i.id) AS has_transcript,
          (i.video_url IS NOT NULL) AS has_video,
          (SELECT COUNT(*) FROM item_files f WHERE f.item_id = i.id) AS has_files,
          ${snipExpr} AS snip
   FROM items i
   LEFT JOIN speakers sp ON sp.id = i.speaker_id
   LEFT JOIN collections co ON co.id = i.collection_id
   ${joins.join(" ")}
   WHERE ${where.join(" AND ")}
   ORDER BY ${orderBy}
   LIMIT 300`,
  ...args
);

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const results = items.map((it) => ({
  ...it,
  snipHtml: it.snip ? esc(it.snip).split("@@H@@").join("<mark>").split("@@/H@@").join("</mark>") : "",
}));

const collections = await all<{ title: string; slug: string }>(
  db, `SELECT title, slug FROM collections WHERE id IN (SELECT DISTINCT collection_id FROM items WHERE collection_id IS NOT NULL) ORDER BY title`
);
const catCounts = await all<{ category: string; n: number }>(
  db, `SELECT category, COUNT(*) n FROM items WHERE published=1 GROUP BY category`
);
const countOf = (k: string) => catCounts.find((c) => c.category === k)?.n ?? 0;
const videoCount = (await all<{ n: number }>(
  db, `SELECT COUNT(*) n FROM items WHERE published=1 AND video_url IS NOT NULL`
))[0]?.n ?? 0;
---
<Base description="Sermons, classes, conferences, and open-air preaching by Michael Coughlin — searchable, transcribed, and indexed by scripture.">
  <section class="section container">
    <h1>Browse the library</h1>

    <div class="pill-line">
      <span class="pill-label">Watch</span>
      <a class={`pill ${!video ? "on" : ""}`} href={linkTo({ video: false })}>All</a>
      <a class={`pill ${video ? "on" : ""}`} href={linkTo({ video: true })}>Available on YouTube <span class="n">{videoCount}</span></a>
    </div>


    {/* Type and Series are both dropdowns. Seven type pills plus a pill per
        collection filled most of a phone screen before a single sermon showed.
        Counts move into the option text so nothing is lost. One GET form, so it
        works without JavaScript; the script below only removes the extra click. */}
    <form class="filter-row" method="GET" data-filter-form>
      <label class="pill-label" for="category">Type</label>
      <select id="category" name="category" class="filter-select">
        <option value="">All types</option>
        {CATEGORIES.map((c) => countOf(c.key) > 0 && (
          <option value={c.key} selected={category === c.key}>{c.label} ({countOf(c.key)})</option>
        ))}
      </select>

      <label class="pill-label" for="collection">Series</label>
      <select id="collection" name="collection" class="filter-select">
        <option value="">All series</option>
        {collections.map((c) => (
          <option value={c.slug} selected={collection === c.slug}>{c.title}</option>
        ))}
      </select>

      <label class="pill-label" for="sort">Sort</label>
      <select id="sort" name="sort" class="filter-select">
        <option value="">Newest first</option>
        <option value="old" selected={sort === "old"}>Oldest first</option>
      </select>

      {video && <input type="hidden" name="video" value="1" />}
      {q && <input type="hidden" name="q" value={q} />}
      <button class="btn btn-outline btn-sm" type="submit" data-filter-go>Go</button>
    </form>

    <form method="GET" class="filters card">
      <input type="hidden" name="category" value={category} />
      <input type="hidden" name="collection" value={collection} />
      {video && <input type="hidden" name="video" value="1" />}
      {sort && <input type="hidden" name="sort" value={sort} />}
      <div class="field-row">
        <div><label for="q">Search</label><input id="q" name="q" value={q} placeholder="Title, passage, or anything said…" /></div>
      </div>
      <div style="margin-top:12px;display:flex;gap:10px">
        <button class="btn btn-primary btn-sm" type="submit">Search</button>
        <a class="btn btn-outline btn-sm" href="/">Reset</a>
      </div>
    </form>

    <div class="result-bar">
      <p class="muted" data-result-count>{items.length}{items.length === 300 ? "+" : ""} item{items.length === 1 ? "" : "s"}</p>
      {/* Shown by progress.js only once something has actually been listened to,
          so the control never appears to a first-time visitor. */}
      <label class="hide-listened muted" hidden title="Based on what you've played in this browser">
        <input type="checkbox" data-hide-listened /> Hide listened
      </label>
    </div>

    {results.length === 0 ? <p class="muted">Nothing matches those filters.</p> : (
      <div class="list">
        {results.map((it) => (
          <a class="card row" href={`/listen/${it.slug}`} data-slug={it.slug}>
            <div class="row-main">
              <div class="row-tags">
                <span class="badge badge-cat">{CATEGORY_LABEL[it.category] ?? it.category}</span>
                {it.collection_title && <span class="badge">{it.collection_title}</span>}
                {it.series_part && <span class="badge badge-part">{it.series_part}</span>}
                {it.has_transcript ? <span class="badge">📄 transcript</span> : null}
                {it.has_video ? <span class="badge badge-video">📺 video</span> : null}
                {it.has_files ? <span class="badge">📎 handout</span> : null}
              </div>
              <h3 style="margin:6px 0 2px">{it.title}</h3>
              {it.passage_ref && <span class="passage-tag">{it.passage_ref}</span>}
              {it.snipHtml && <p class="row-snip" set:html={it.snipHtml} />}
              <p class="muted" style="margin:2px 0 0">{it.speaker_name}</p>
            </div>
            <span class="muted date">{fmtDate(it.recorded_on)}</span>
          </a>
        ))}
      </div>
    )}
  </section>
  <script is:inline>
    // Progressive enhancement: with JS, changing the series navigates straight
    // away and the Go button is redundant. Without it, the form still submits.
    (() => {
      const form = document.querySelector("[data-filter-form]");
      if (!form) return;
      const go = form.querySelector("[data-filter-go]");
      if (go) go.hidden = true;
      form.querySelectorAll("select").forEach((sel) => {
        const mark = () => sel.toggleAttribute("data-all", sel.value === "");
        mark();
        sel.addEventListener("change", () => { mark(); form.requestSubmit(); });
      });
      // Empty selects would still be sent, leaving "?category=&collection=&sort=old".
      // Disabled controls are omitted, so the URL only carries real filters.
      form.addEventListener("submit", () => {
        form.querySelectorAll("select").forEach((sel) => { if (!sel.value) sel.disabled = true; });
      });
    })();
  </script>
  <script src="/progress.js" is:inline defer></script>
</Base>

<style>
  .pill-line { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 10px; }
  .pill-line:last-of-type { margin-bottom: 18px; }
  .pill-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; color: var(--text-soft); margin-right: 2px; min-width: 44px; }
  .pill { padding: 6px 13px; border: 1px solid var(--border); border-radius: 999px; color: var(--text-soft); font-size: .9rem; font-weight: 500; }
  .pill:hover { text-decoration: none; border-color: var(--brand-300); color: var(--text); }
  .pill.on { background: var(--brand); color: #07121a; border-color: var(--brand); }
  .pill .n { opacity: .7; font-size: .8rem; }
  /* Two across. The full-width rows left a lot of dead space on a wide screen,
     and at two columns the excerpt still has room to be readable. */
  .list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 8px; }
  .row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .row[hidden] { display: none; }
  @media (max-width: 760px) { .list { grid-template-columns: 1fr; } }
  .row:hover { text-decoration: none; border-color: var(--brand-300); }
  .row-main { min-width: 0; }
  .row-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .passage-tag { display: inline-block; font-family: var(--serif); color: var(--brand); font-weight: 600; font-size: .95rem; }
  .row-snip { margin: 6px 0 0; font-size: .9rem; line-height: 1.5; color: var(--text-soft); }
  .row-snip mark { background: color-mix(in srgb, var(--brand) 24%, transparent); color: var(--text); padding: 0 1px; border-radius: 2px; }
  .date { white-space: nowrap; font-size: .88rem; }
  .filter-select {
    padding: 6px 30px 6px 13px; border: 1px solid var(--border); border-radius: 999px;
    background: transparent; color: var(--text-soft); font-size: .9rem; font-weight: 500;
    font-family: inherit; max-width: min(340px, 70vw); cursor: pointer;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
                      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 14px center, right 9px center;
    background-size: 5px 5px, 5px 5px; background-repeat: no-repeat;
  }
  .filter-select:hover { border-color: var(--brand-300); color: var(--text); }
  /* .btn sets an explicit display, which beats the [hidden] attribute's UA rule
     -- the same trap the Hide-listened control hit. Opt back out explicitly. */
  .btn[hidden] { display: none; }
  /* An explicit value means the filter is on -- match the active pill. */
  .filter-select:not([data-all]) { color: var(--text); border-color: var(--brand-300); }
  .filter-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 18px; }
  .filter-select option { background: var(--bg-card); color: var(--text); }
  .result-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
  .result-bar p { margin: 0; }
  .hide-listened { display: inline-flex; align-items: center; gap: 7px; font-size: .88rem; cursor: pointer; }
  /* An explicit display beats the [hidden] attribute's UA rule, so the
     control has to opt back out or it shows before anything is listened to. */
  .hide-listened[hidden] { display: none; }
  .hide-listened input { accent-color: var(--brand); }
</style>
